// Prisma schema for GLAdmin
// Multi-currency enabled — all financial transactions store
// VED (Bolívares) + USD amounts + exchange rate at time of record

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  userName           String    @unique
  password           String
  firstName          String
  lastName           String
  idRole             Int
  mustChangePassword Boolean   @default(false)
  lastLogin          DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  role          Role           @relation(fields: [idRole], references: [id])
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenHash  String
  userId     Int
  deviceInfo String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Permission {
  id        Int      @id @default(autoincrement())
  name      String?
  slug      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────
// CUSTOMER (Slice 3 — Ventas)
// ────────────────────────────────────────────
model Customer {
  id           Int      @id @default(autoincrement())
  idCardNumber String
  firstName    String
  lastName     String
  address      String?
  phoneNumber  String?
  email        String?
  available    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales Sale[]
}

// ────────────────────────────────────────────
// SUPPLIER (Slice 1 — Compras)
// ────────────────────────────────────────────
model Supplier {
  id                Int      @id @default(autoincrement())
  documentNumber    String
  companyName       String
  businessName      String?  // Razón Social
  fiscalAddress     String?  // Dirección Fiscal
  taxId             String?  // RIF
  firstName         String?
  lastName          String?
  address           String?
  phoneNumber       String?
  email             String?
  taxWithholdingAgent Boolean @default(false) // sujeto a retención IVA/ISLR
  available         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stocks            Stock[]
  purchaseOrders    PurchaseOrder[]
  withholdingRecords WithholdingRecord[]
}

// ────────────────────────────────────────────
// COMPANY
// ────────────────────────────────────────────
model Company {
  id             Int      @id @default(autoincrement())
  documentNumber String
  name           String
  address        String
  phoneNumber    String
  email          String
  website        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  licenses License[]
}

model License {
  id         Int       @id @default(autoincrement())
  code       String?
  idCompany  Int
  available  Boolean?
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [idCompany], references: [id])
}

// ────────────────────────────────────────────
// CURRENCY / EXCHANGE RATE (Transversal)
// ────────────────────────────────────────────
model Currency {
  id        Int      @id @default(autoincrement())
  code      String?
  name      String?
  symbol    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exchangeRates ExchangeRate[]
}

model ExchangeRate {
  id         Int      @id @default(autoincrement())
  rate       Float    // VED per 1 unit of foreign currency
  currencyId Int?     // which currency (USD, EUR, etc.)
  type       String   @default("official") // "official" | "paralelo" | "manual"
  date       DateTime // date the rate was recorded
  source     String?  // "BCV", "dolartoday", "enparalelovzla", "manual"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  currency              Currency?                @relation(fields: [currencyId], references: [id])
  purchaseOrders        PurchaseOrder[]          @relation("CalculationRate")
  officialPurchaseOrders PurchaseOrder[]         @relation("OfficialRate")
  sales                 Sale[]                   @relation("CalculationRate")
  officialSales         Sale[]                   @relation("OfficialRate")
  productLinks          ProductsExchangeRates[]
}

model Module {
  id        Int      @id @default(autoincrement())
  name      String?
  available Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────
// TAX / PRODUCT (Slice 2 — Inventario)
// ────────────────────────────────────────────
model Tax {
  id         Int      @id @default(autoincrement())
  name       String?
  percentage Int
  formula    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products Product[]
}

model Product {
  id          Int          @id @default(autoincrement())
  code        String
  name        String
  price       Float        // VED
  dollarPrice Float?
  idTax       Int?
  observation String?
  available   Boolean      @default(true)
  image       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tax                      Tax?                       @relation(fields: [idTax], references: [id])
  stocks                   Stock[]
  purchaseOrderDetails     PurchaseOrderDet[]
  saleDetails              SalesDet[]
  exchangeRateLinks        ProductsExchangeRates[]
}

model Batch {
  id          Int      @id @default(autoincrement())
  code        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks Stock[]
}

model Stock {
  id         Int       @id @default(autoincrement())
  idProduct  Int
  idSupplier Int?
  idBatch    Int?
  existence  Int
  available  Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  product   Product    @relation(fields: [idProduct], references: [id])
  supplier  Supplier?  @relation(fields: [idSupplier], references: [id])
  batch     Batch?     @relation(fields: [idBatch], references: [id])
  stockDets StockDet[]
}

model StockDet {
  id          Int       @id @default(autoincrement())
  idStock     Int
  type        Int       // 1 = entry, -1 = exit
  quantity    Int
  expiryDate  DateTime?
  observation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stock Stock @relation(fields: [idStock], references: [id])
}

// ────────────────────────────────────────────
// PURCHASE ORDERS (Slice 1 — Compras)
// Multi-currency: amount in VED + amountUsd + exchangeRate + officialExchangeRate
// ────────────────────────────────────────────
model PurchaseOrder {
  id                     Int      @id @default(autoincrement())
  idSupplier             Int
  code                   String?
  date                   DateTime?
  amount                 Float?   // VED total
  amountUsd              Float?   // USD total
  exchangeRate           Float?   // rate used at creation (usually paralelo)
  exchangeRateId         Int?
  officialExchangeRate   Float?   // official BCV rate for legal reporting
  officialExchangeRateId Int?
  paymentMethod          Int?
  status                 Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  supplier                  Supplier           @relation(fields: [idSupplier], references: [id])
  details                   PurchaseOrderDet[]
  accountsPayables          AccountsPayable[]
  exchangeRateRef           ExchangeRate?      @relation("CalculationRate", fields: [exchangeRateId], references: [id])
  officialExchangeRateRef   ExchangeRate?      @relation("OfficialRate", fields: [officialExchangeRateId], references: [id])
  withholdingRecords        WithholdingRecord[]
}

model PurchaseOrderDet {
  id              Int      @id @default(autoincrement())
  idPurchaseOrder Int
  idProduct       Int
  quantity        Int?
  unitPrice        Float?  // VED unit price
  unitPriceUsd     Float?  // USD unit price
  subtotal        Float?   // VED subtotal
  subtotalUsd     Float?   // USD subtotal
  observation     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder  PurchaseOrder @relation(fields: [idPurchaseOrder], references: [id])
  product        Product       @relation(fields: [idProduct], references: [id])
}

// ────────────────────────────────────────────
// ACCOUNTS PAYABLE (Slice 1 — CXP)
// ────────────────────────────────────────────
model AccountsPayable {
  id              Int      @id @default(autoincrement())
  idPurchaseOrder Int
  dueDate         DateTime?
  issueDate       DateTime?
  amount          Float?   // VED
  amountUsd       Float?   // USD
  exchangeRate    Float?
  credit          Float?
  status          Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [idPurchaseOrder], references: [id])
}

// ────────────────────────────────────────────
// TAX WITHHOLDING (Slice 1 — Retenciones)
// IVA e ISLR (75%/100%)
// ────────────────────────────────────────────
model WithholdingRecord {
  id                Int      @id @default(autoincrement())
  idSupplier        Int
  idPurchaseOrder   Int?
  type              String   // "IVA" | "ISLR"
  percentage        Float    // 75 or 100
  baseAmount        Float    // VED taxable base
  baseAmountUsd     Float?
  withheldAmount    Float    // VED withheld
  withheldAmountUsd Float?
  exchangeRate      Float?
  documentNumber    String?  // comprobante de retención
  period            String?  // tax period "YYYY-MM"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  supplier      Supplier      @relation(fields: [idSupplier], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [idPurchaseOrder], references: [id])
}

// ────────────────────────────────────────────
// SALES (Slice 3 — Ventas)
// Multi-currency
// ────────────────────────────────────────────
model Sale {
  id                     Int       @id @default(autoincrement())
  idCustomer             Int?
  code                   String?
  date                   DateTime?
  amount                 Float?    // VED total
  amountUsd              Float?    // USD total
  exchangeRate           Float?
  exchangeRateId         Int?
  officialExchangeRate   Float?    // official BCV rate for legal reporting
  officialExchangeRateId Int?
  paymentMethod          Int?
  status                 Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  customer               Customer?           @relation(fields: [idCustomer], references: [id])
  details                SalesDet[]
  accountsReceivables    AccountsReceivable[]
  exchangeRateRef        ExchangeRate?       @relation("CalculationRate", fields: [exchangeRateId], references: [id])
  officialExchangeRateRef ExchangeRate?       @relation("OfficialRate", fields: [officialExchangeRateId], references: [id])
}

model SalesDet {
  id          Int      @id @default(autoincrement())
  idSale      Int
  idProduct   Int
  quantity    Int?
  unitPrice    Float?  // VED unit price
  unitPriceUsd Float?  // USD unit price
  subtotal    Float?   // VED subtotal
  subtotalUsd Float?   // USD subtotal
  observation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sale    Sale    @relation(fields: [idSale], references: [id])
  product Product @relation(fields: [idProduct], references: [id])
}

model AccountsReceivable {
  id         Int       @id @default(autoincrement())
  idSale     Int?
  dueDate    DateTime?
  issueDate  DateTime?
  amount     Float?    // VED
  amountUsd  Float?    // USD
  exchangeRate Float?
  credit     Float?
  status     Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sale Sale? @relation(fields: [idSale], references: [id])
}

// ────────────────────────────────────────────
// PRODUCT EXCHANGE RATE LINKS
// ────────────────────────────────────────────
model ProductsExchangeRates {
  id              Int      @id @default(autoincrement())
  idProduct       Int
  idExchangeRate  Int
  value           Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product      Product      @relation(fields: [idProduct], references: [id])
  exchangeRate ExchangeRate @relation(fields: [idExchangeRate], references: [id])
}
