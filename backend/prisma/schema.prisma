// Prisma schema for GLAdmin
// Multi-currency enabled — all financial transactions store
// VED (Bolívares) + USD amounts + exchange rate at time of record

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  userOrganizations  UserOrganization[]
  invites            Invite[]
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  userName           String    @unique
  password           String
  firstName          String
  lastName           String
  idRole             Int
  mustChangePassword Boolean   @default(false)
  lastLogin          DateTime?
  isActive           Boolean   @default(true)
  version            Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  currentOrganizationId  Int?

  role                   Role                      @relation(fields: [idRole], references: [id])
  refreshTokens          RefreshToken[]
  currentOrganization    Organization?             @relation("CurrentOrg", fields: [currentOrganizationId], references: [id])
  organizations          UserOrganization[]
  invites                Invite[]                  @relation("InvitedBy")
  pagoMovilTransactions  PagoMovilTransaction[]
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenId    String   @unique
  tokenHash  String
  userId     Int
  deviceInfo String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Permission {
  id        Int      @id @default(autoincrement())
  name      String?
  slug      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────
// ORGANIZATION (Multi-tenant core)
// ────────────────────────────────────────────
model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  version   Int      @default(0)
  isActive  Boolean  @default(true)
  settings  String?
  planId    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan                  Plan?                    @relation(fields: [planId], references: [id])
  users                 User[]                   @relation("CurrentOrg")
  userMemberships       UserOrganization[]
  suppliers             Supplier[]
  customers             Customer[]
  companies             Company[]
  brands                Brand[]
  categories            Category[]
  products              Product[]
  taxes                 Tax[]
  batches               Batch[]
  stocks                Stock[]
  purchaseOrders        PurchaseOrder[]
  purchaseOrderDets     PurchaseOrderDet[]
  sales                 Sale[]
  salesDets             SalesDet[]
  exchangeRates         ExchangeRate[]
  exchangeRateDays      ExchangeRateDay[]
  withholdingRecords    WithholdingRecord[]
  accountsPayable       AccountsPayable[]
  accountsReceivable    AccountsReceivable[]
  invites               Invite[]
  pagoMovilConfigs      PagoMovilConfig[]
  pagoMovilTransactions PagoMovilTransaction[]
  syncCursors           SyncCursor[]
  syncConflicts         SyncConflict[]
  auditLogs             AuditLog[]
}

model Plan {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  label     String
  amount    Int
  currency  String   @default("usd")
  interval  String
  features  String
  maxUsers  Int      @default(5)
  version   Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[]
}

model UserOrganization {
  userId         Int
  organizationId Int
  roleId         Int

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@id([userId, organizationId])

  @@index([organizationId])
}

model Invite {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  email          String
  organizationId Int
  roleId         Int
  invitedById    Int
  expiresAt      DateTime
  version        Int      @default(0)
  used           Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId])
}

model PagoMovilConfig {
  id             Int      @id @default(autoincrement())
  organizationId Int      @unique
  phoneNumber    String
  bankId         String
  idNumber       String
  exchangeRate   Float
  version        Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model PagoMovilTransaction {
  id             Int      @id @default(autoincrement())
  organizationId Int
  userId         Int
  amountVes      Float
  amountUsd      Float
  bankId         String
  phoneNumber    String
  reference      String
  proofImage     String?
  version        Int      @default(0)
  status         String   @default("pending")
  reviewedBy     Int?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([status])
}

// ────────────────────────────────────────────
// CUSTOMER (Slice 3 — Ventas)
// ────────────────────────────────────────────
model Customer {
  id           Int      @id @default(autoincrement())
  idCardNumber String
  firstName    String
  lastName     String
  address      String?
  phoneNumber  String?
  email        String?
  version      Int      @default(0)
  available    Boolean  @default(true)
  isWithholdingAgent   Boolean  @default(false)
  withholdingPercentage Float?   // 75 or 100 — null if not a withholding agent
  withholdingProof     String?  // uploaded proof document filename
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  organizationId Int

  organization Organization @relation(fields: [organizationId], references: [id])
  sales        Sale[]

  @@index([organizationId])
  @@index([organizationId, available])
  @@index([organizationId, updatedAt])
}

// ────────────────────────────────────────────
// SUPPLIER (Slice 1 — Compras)
// ────────────────────────────────────────────
model Supplier {
  id                Int      @id @default(autoincrement())
  companyName       String
  businessName      String?
  fiscalAddress     String?
  taxId             String?
  firstName         String?
  lastName          String?
  address           String?
  phoneNumber       String?
  email             String?
  taxWithholdingAgent Boolean @default(false)
  version           Int      @default(0)
  available         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  organizationId    Int

  organization      Organization          @relation(fields: [organizationId], references: [id])
  stocks            Stock[]
  purchaseOrders    PurchaseOrder[]
  withholdingRecords WithholdingRecord[]

  @@index([organizationId])
  @@index([organizationId, available])
  @@index([organizationId, updatedAt])
}

// ────────────────────────────────────────────
// COMPANY
// ────────────────────────────────────────────
model Company {
  id             Int      @id @default(autoincrement())
  taxId          String   @default("")
  name           String
  address        String
  phoneNumber    String
  email          String
  website        String?
  isWithholdingAgent   Boolean  @default(false)
  withholdingPercentage Float?
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organizationId Int

  organization Organization @relation(fields: [organizationId], references: [id])
  licenses     License[]

  @@index([organizationId])
  @@index([organizationId, updatedAt])
}

model License {
  id         Int       @id @default(autoincrement())
  code       String?
  idCompany  Int
  version    Int       @default(0)
  available  Boolean?
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [idCompany], references: [id])
}

// ────────────────────────────────────────────
// CURRENCY / EXCHANGE RATE (Transversal)
// ────────────────────────────────────────────
model Currency {
  id        Int      @id @default(autoincrement())
  code      String?
  name      String?
  symbol    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exchangeRates ExchangeRate[]
}

model ExchangeRate {
  id         Int      @id @default(autoincrement())
  rate       Float    // VED per 1 unit of foreign currency
  currencyId Int?     // which currency (USD, EUR, etc.)
  type       String   @default("official") // "official" | "paralelo" | "manual"
  date       DateTime // date the rate was recorded
  source     String?  // "BCV", "dolartoday", "enparalelovzla", "manual"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  organizationId Int

  organization          Organization             @relation(fields: [organizationId], references: [id])
  currency              Currency?                @relation(fields: [currencyId], references: [id])
  purchaseOrders        PurchaseOrder[]          @relation("CalculationRate")
  officialPurchaseOrders PurchaseOrder[]         @relation("OfficialRate")
  sales                 Sale[]                   @relation("CalculationRate")
  officialSales         Sale[]                   @relation("OfficialRate")
  productLinks          ProductsExchangeRates[]

  @@index([organizationId])
  @@index([date])
  @@index([organizationId, updatedAt])
}

model ExchangeRateDay {
  id              Int      @id @default(autoincrement())
  date            DateTime
  rateBcvUsd      Float?
  rateParalelo    Float?
  source          String?  @default("dolarapi")
  organizationId  Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, date])
  @@map("exchange_rate_days")
}

model Module {
  id        Int      @id @default(autoincrement())
  name      String?
  available Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────
// TAX / PRODUCT (Slice 2 — Inventario)
// ────────────────────────────────────────────
model Tax {
  id         Int      @id @default(autoincrement())
  name       String?
  percentage Int
  formula    String?
  version    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  organizationId Int

  organization Organization @relation(fields: [organizationId], references: [id])
  products     Product[]

  @@index([organizationId])
  @@index([organizationId, updatedAt])
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  version     Int       @default(0)
  available   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  organizationId Int

  organization Organization @relation(fields: [organizationId], references: [id])
  products     Product[]

  @@index([organizationId])
  @@index([organizationId, available])
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  idParent    Int?
  parent      Category?  @relation("CategoryHierarchy", fields: [idParent], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  version     Int        @default(0)
  available   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  organizationId Int

  organization Organization @relation(fields: [organizationId], references: [id])
  products     Product[]

  @@index([organizationId])
  @@index([organizationId, available])
  @@index([idParent])
}

model Product {
  id          Int          @id @default(autoincrement())
  code        String
  name        String
  price           Float      // VED
  dollarPrice      Float?
  baseCost        Float?       // Costo base en USD
  margin          Float        @default(20)  // Porcentaje de margen/protección
  totalExistence  Int          @default(0)
  idTax       Int?
  idBrand     Int?
  idCategory  Int?
  observation String?
  version     Int          @default(0)
  available   Boolean      @default(true)
  image       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  organizationId Int

  organization             Organization               @relation(fields: [organizationId], references: [id])
  tax                      Tax?                       @relation(fields: [idTax], references: [id])
  brand                    Brand?                     @relation(fields: [idBrand], references: [id])
  category                 Category?                  @relation(fields: [idCategory], references: [id])
  stocks                   Stock[]
  purchaseOrderDetails     PurchaseOrderDet[]
  saleDetails              SalesDet[]
  exchangeRateLinks        ProductsExchangeRates[]

  @@index([organizationId])
  @@index([organizationId, available])
  @@index([organizationId, updatedAt])
}

model Batch {
  id          Int      @id @default(autoincrement())
  code        String
  description String?
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  organizationId Int

  organization Organization @relation(fields: [organizationId], references: [id])
  stocks       Stock[]

  @@index([organizationId])
}

model Stock {
  id         Int       @id @default(autoincrement())
  idProduct  Int
  idSupplier Int?
  idBatch    Int?
  idPurchaseOrder Int?
  existence  Int
  version    Int      @default(0)
  available  Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  organizationId Int

  organization  Organization  @relation(fields: [organizationId], references: [id])
  product       Product       @relation(fields: [idProduct], references: [id])
  supplier      Supplier?     @relation(fields: [idSupplier], references: [id])
  batch         Batch?        @relation(fields: [idBatch], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [idPurchaseOrder], references: [id])
  stockDets     StockDet[]

  @@index([organizationId])
  @@index([organizationId, available])
}

model StockDet {
  id          Int       @id @default(autoincrement())
  idStock     Int
  type        Int       // 1 = entry, -1 = exit
  quantity    Int
  expiryDate  DateTime?
  observation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stock Stock @relation(fields: [idStock], references: [id])
}

// ────────────────────────────────────────────
// PURCHASE ORDERS (Slice 1 — Compras)
// Multi-currency: amount in VED + amountUsd + exchangeRate + officialExchangeRate
// ────────────────────────────────────────────
model PurchaseOrder {
  id                     Int      @id @default(autoincrement())
  idSupplier             Int
  code                   String?
  date                   DateTime?
  amount                 Float?   // VED total (base + IVA)
  amountUsd              Float?   // USD total (base + IVA)
  baseAmount             Float?   // Base Imponible (VED) — sum of line subtotals before IVA
  baseAmountUsd          Float?   // Base Imponible (USD)
  ivaAmount              Float?   // Total IVA (VED)
  ivaAmountUsd           Float?   // Total IVA (USD)
  exchangeRate           Float?   // rate used at creation (usually paralelo)
  exchangeRateId         Int?
  exchangeRateDayId      Int?
  officialExchangeRate   Float?   // official BCV rate for legal reporting
  officialExchangeRateId Int?
  paymentMethod          Int?
  status                 Int?
  version                Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  organizationId         Int

  organization               Organization           @relation(fields: [organizationId], references: [id])
  supplier                   Supplier               @relation(fields: [idSupplier], references: [id])
  details                   PurchaseOrderDet[]
  accountsPayables          AccountsPayable[]
  exchangeRateRef            ExchangeRate?            @relation("CalculationRate", fields: [exchangeRateId], references: [id])
  exchangeRateDayRef         ExchangeRateDay?         @relation(fields: [exchangeRateDayId], references: [id])
  officialExchangeRateRef   ExchangeRate?      @relation("OfficialRate", fields: [officialExchangeRateId], references: [id])
  withholdingRecords        WithholdingRecord[]
  stocks                    Stock[]

  @@index([organizationId])
  @@index([status])
  @@index([date])
  @@index([code])
}

model PurchaseOrderDet {
  id               Int      @id @default(autoincrement())
  idPurchaseOrder  Int
  idProduct        Int
  quantity         Int?
  receivedQuantity Int      @default(0)
  unitPrice        Float?   // VED unit price
  unitPriceUsd     Float?   // USD unit price
  subtotal         Float?   // VED subtotal
  subtotalUsd      Float?   // USD subtotal
  observation      String?
  version          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  organizationId   Int

  organization    Organization  @relation(fields: [organizationId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [idPurchaseOrder], references: [id])
  product        Product       @relation(fields: [idProduct], references: [id])

  @@index([organizationId])
}

// ────────────────────────────────────────────
// ACCOUNTS PAYABLE (Slice 1 — CXP)
// ────────────────────────────────────────────
model AccountsPayable {
  id              Int      @id @default(autoincrement())
  idPurchaseOrder Int
  dueDate         DateTime?
  issueDate       DateTime?
  amount          Float?   // VED
  amountUsd       Float?   // USD
  exchangeRate    Float?
  credit          Float?
  status          Int?
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organizationId  Int

  organization    Organization  @relation(fields: [organizationId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [idPurchaseOrder], references: [id])

  @@index([organizationId])
  @@index([status])
}

// ────────────────────────────────────────────
// TAX WITHHOLDING (Slice 1 — Retenciones)
// IVA e ISLR (75%/100%)
// ────────────────────────────────────────────
model WithholdingRecord {
  id                Int      @id @default(autoincrement())
  idSupplier        Int
  idPurchaseOrder   Int?
  type              String
  percentage        Float
  baseAmount        Float
  baseAmountUsd     Float?
  withheldAmount    Float
  withheldAmountUsd Float?
  exchangeRate      Float?
  documentNumber    String?
  period            String?
  withholdingProof  String?  // uploaded proof document filename
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  organizationId    Int

  organization      Organization    @relation(fields: [organizationId], references: [id])
  supplier          Supplier        @relation(fields: [idSupplier], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [idPurchaseOrder], references: [id])

  @@index([organizationId])
}

// ────────────────────────────────────────────
// SALES (Slice 3 — Ventas)
// Multi-currency
// ────────────────────────────────────────────
model Sale {
  id                     Int       @id @default(autoincrement())
  idCustomer             Int?
  code                   String?
  date                   DateTime?
  amount                 Float?    // VED total
  amountUsd              Float?    // USD total
  exchangeRate           Float?
  exchangeRateId         Int?
  officialExchangeRate   Float?    // official BCV rate for legal reporting
  officialExchangeRateId Int?
  totalTax               Float?    // VED — sum of item IVA
  totalTaxUsd            Float?    // USD — sum of item IVA
  withholdingPercentage  Float?    // 75 or 100 — null if no withholding applies
  withholdingAmount      Float?    // VED — withheld amount
  withholdingAmountUsd   Float?    // USD — withheld amount
  paymentMethod          Int?
  status                 Int?
  version                Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  organizationId         Int

  organization               Organization        @relation(fields: [organizationId], references: [id])
  customer                   Customer?           @relation(fields: [idCustomer], references: [id])
  details                SalesDet[]
  accountsReceivables    AccountsReceivable[]
  exchangeRateRef        ExchangeRate?       @relation("CalculationRate", fields: [exchangeRateId], references: [id])
  officialExchangeRateRef ExchangeRate?       @relation("OfficialRate", fields: [officialExchangeRateId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([date])
  @@index([code])
}

model SalesDet {
  id          Int      @id @default(autoincrement())
  idSale      Int
  idProduct   Int
  quantity    Int?
  unitPrice    Float?  // VED unit price
  unitPriceUsd Float?  // USD unit price
  subtotal    Float?   // VED subtotal
  subtotalUsd Float?   // USD subtotal
  taxName     String?  // e.g. "IVA"
  taxPercentage Float? // e.g. 16
  taxAmount   Float?   // VED tax amount
  taxAmountUsd Float?  // USD tax amount
  observation String?
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  organizationId Int

  organization Organization @relation(fields: [organizationId], references: [id])
  sale         Sale         @relation(fields: [idSale], references: [id])
  product Product @relation(fields: [idProduct], references: [id])

  @@index([organizationId])
}

model AccountsReceivable {
  id         Int       @id @default(autoincrement())
  idSale     Int?
  dueDate    DateTime?
  issueDate  DateTime?
  amount     Float?    // VED
  amountUsd  Float?    // USD
  exchangeRate Float?
  credit     Float?
  status     Int?
  version    Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  organizationId Int

  organization Organization @relation(fields: [organizationId], references: [id])
  sale         Sale?        @relation(fields: [idSale], references: [id])

  @@index([organizationId])
  @@index([status])
}

// ────────────────────────────────────────────
// PRODUCT EXCHANGE RATE LINKS
// ────────────────────────────────────────────
model ProductsExchangeRates {
  id              Int      @id @default(autoincrement())
  idProduct       Int
  idExchangeRate  Int
  value           Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product      Product      @relation(fields: [idProduct], references: [id])
  exchangeRate ExchangeRate @relation(fields: [idExchangeRate], references: [id])
}

model SyncCursor {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @unique
  lastPullAt      DateTime
  lastPushAt      DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
}

model SyncConflict {
  id              Int       @id @default(autoincrement())
  organizationId  Int
  table           String
  recordId        Int?
  localData       String
  serverData      String
  localTimestamp   DateTime
  description     String
  status          String    @default("pending")
  resolvedBy      Int?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
}

model AuditLog {
  id              Int      @id @default(autoincrement())
  organizationId  Int
  userId          Int?
  action          String
  entity          String
  entityId        Int?
  metadata        String?
  ipAddress       String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}
