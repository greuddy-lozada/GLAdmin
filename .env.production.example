# Copy to .env.production on the server and fill in real values.
# Never commit .env.production.

# ── PostgreSQL (used by docker-compose.prod.yml) ──
POSTGRES_USER=cuadra
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=cuadra

# ── Backend ──
JWT_SECRET=change-me-to-a-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Public URL testers use (no trailing slash). Example: http://203.0.113.10:8081
FRONTEND_URL=http://YOUR_IP:8081

# Optional overrides (compose sets DATABASE_URL / REDIS_URL / PORT automatically)
# PORT=4000
# LOG_LEVEL=info
